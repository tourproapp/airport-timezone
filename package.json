{
  "name": "@tourproapp/airport-timezone",
  "version": "0.1.0",
  "description": "IATA airport code to IANA timezone lookup. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "iata",
    "airport",
    "timezone",
    "iana",
    "aviation",
    "travel",
    "tz"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tourproapp/airport-timezone"
  },
  "homepage": "https://tourpro.app",
  "bugs": "https://github.com/tourproapp/airport-timezone/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
